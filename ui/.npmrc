# Dependencies are pinned (build-plan step 12, ARCHITECTURE.md D-69).
# save-exact: `npm install x` writes "x": "1.2.3", never a range, so the
#   versions in package.json are the versions in package-lock.json.
# ignore-scripts: no package runs code of its own at install time — the
#   usual way a compromised npm package reaches a developer's machine. The
#   UI's toolchain needs none (its native parts ship prebuilt).
# audit-level: `npm audit` (CI's security job) fails on moderate or worse.
save-exact=true
ignore-scripts=true
audit-level=moderate
engine-strict=true
